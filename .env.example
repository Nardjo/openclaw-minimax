# OpenClaw Multi-Agent - Coolify Ready
# 
# Déploiement:
# 1. Copiez ce fichier: cp .env.example .env
# 2. Remplissez les variables ci-dessous
# 3. Push sur GitHub
# 4. Déployez via Coolify (il lira automatiquement les variables)
#
# Configuration minimale pour fonctionner:

# === SECURITE ===
# Générez avec: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=changeme

# === AI PROVIDER: MINIMAX (principal) ===
# Inscrivez-vous sur: https://platform.minimax.io/
# Créez un Token Plan et copiez la clé API
MINIMAX_API_KEY=votre_cle_minimax

# === AI PROVIDER: OPENROUTER (optionnel) ===
# Décommentez si vous voulez un backup ou un autre modèle
# OPENROUTER_API_KEY=votre_cle_openrouter

# === TELEGRAM BOTS ===
# Créez des bots via @BotFather sur Telegram
# Ajoutez autant de bots que nécessaire avec le format: TELEGRAM_BOT_TOKEN_<NOM>
TELEGRAM_BOT_TOKEN_GENERAL=token_bot_general
TELEGRAM_BOT_TOKEN_TECH=token_bot_tech
TELEGRAM_BOT_TOKEN_COMMERCIAL=token_bot_commercial
# TELEGRAM_BOT_TOKEN_MARKETING=token_marketing
# TELEGRAM_BOT_TOKEN_SUPPORT=token_support

# === ADMIN ===
# Votre ID Telegram pour l'allowlist (obtenez via @userinfobot)
TELEGRAM_ADMIN_USER_ID=votre_id_telegram
