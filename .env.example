# OpenClaw Multi-Agent pour Coolify
# 
# Déploiement:
# 1. Upload sur votre repo GitHub
# 2. Connectez Coolify à GitHub
# 3. Déployez - les variables d'env seront demandées
#
# Configuration minimale requise:

# === SECURITE ===
# Générez avec: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=changeme

# === AI PROVIDER ===
# Obtenez sur: https://openrouter.ai/
OPENROUTER_API_KEY=votre_cle

# === TELEGRAM BOTS ===
# Créez via @BotFather sur Telegram
# Ajoutez autant de bots que nécessaire avec le format: TELEGRAM_BOT_TOKEN_<NOM>
TELEGRAM_BOT_TOKEN_GENERAL=token1
TELEGRAM_BOT_TOKEN_TECH=token2
TELEGRAM_BOT_TOKEN_COMMERCIAL=token3
# TELEGRAM_BOT_TOKEN_MARKETING=token4
# TELEGRAM_BOT_TOKEN_SUPPORT=token5

# === OPTIONAL ===
# Votre ID Telegram pour l'allowlist (@userinfobot)
TELEGRAM_ADMIN_USER_ID=
